# Export these variables before starting Spring Boot; .env is not loaded automatically.
SPRING_PROFILES_ACTIVE=dev
# Required when SPRING_PROFILES_ACTIVE=prod; comma-separated exact frontend origins.
ALLOWED_ORIGINS=http://localhost:5173
MYSQL_URL=jdbc:mysql://localhost:3306/weeb?serverTimezone=Asia/Shanghai
MYSQL_USERNAME=weeb
MYSQL_PASSWORD=
# Generate a new random secret of at least 32 bytes; never reuse a committed key.
JWT_SECRET=
WEEB_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
DEEPSEEK_API_KEY=
# Password reset requires a configured SMTP service.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
PASSWORD_RESET_FROM=
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/reset-password
AVATAR_DIRECTORY=uploads/avatars
# Private, durable directory outside all public static mappings; back up with the database.
CAMPUS_MEDIA_DIRECTORY=.local/campus-media
